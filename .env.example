# ============================================================
# Supabase Configuration
# ============================================================
# Safe for browser consumption (Public):
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER-ONLY SECRET — NEVER prefix with NEXT_PUBLIC_ or expose to client:
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# AI Provider Configuration
# Choose active provider: "gemini" (recommended) or "openai"
# ============================================================
AI_PROVIDER=gemini

# Google Gemini Configuration (SERVER-ONLY SECRETS)
# NEVER prefix with NEXT_PUBLIC_ or expose to client:
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash

# OpenAI Configuration (SERVER-ONLY SECRETS - Optional alternative)
# SERVER-ONLY SECRET — NEVER prefix with NEXT_PUBLIC_ or expose to client:
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# ============================================================
# Company & Application Settings
# (Source: Mudhra Catalogue. Contact details are optional and configurable;
#  do not invent or hardcode placeholder phone numbers or emails)
# ============================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_NAME=Mudhra Branding Solutions

# Optional official company contact details (leave empty until officially configured):
NEXT_PUBLIC_COMPANY_PHONE=
NEXT_PUBLIC_COMPANY_EMAIL=
NEXT_PUBLIC_COMPANY_WEBSITE=
NEXT_PUBLIC_COMPANY_ADDRESS=

# ============================================================
# WhatsApp Bot Integration (Free Tiers Supported)
# ============================================================
# Meta WhatsApp Cloud API (Free tier: 1,000 service conversations/mo):
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=mudhra_poc_whatsapp_verify_token

# Or Twilio WhatsApp Sandbox (Free dev sandbox):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

